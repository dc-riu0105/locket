#!name=Locket Custom Version
#!desc=Crack By DucTri | More and more features to custom your locket!

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
[Script]
# 1. Tùy chỉnh Feature, Video 60s & Caption Cá Nhân
locket-remote = type=http-response,
pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/dc-riu0105/locket/refs/heads/main/Locketunlock.js, require-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by duyvinh09)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/usatalk/locket/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày kích hoạt (by ductri)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/usatalk/locket/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60

